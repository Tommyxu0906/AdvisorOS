# Backend origin for production builds where frontend and backend are deployed separately
# (e.g. frontend on Vercel, backend on Railway/Render/Fly.io). Leave unset for local dev —
# vite.config.ts proxies /api to localhost:8000 instead.
#
# No trailing slash.
VITE_API_BASE_URL=https://your-backend.example.com

# Supabase project, for Google sign-in. Both values are public — the anon key ships in the
# frontend bundle by design; Supabase's row-level security is what actually protects data.
# Leave both unset to run without accounts — the app degrades to BYOK-only (no sign-in button).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
